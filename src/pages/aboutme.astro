---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import site from '../data/site.json';

const { about, home } = site;
const bg = `--bg-desktop:url('${home.background.desktop}');--bg-mobile:url('${home.background.mobile}')`;
---
<Base theme="painting" title="About Me" style={bg}>
  <PageHeader title={about.title} back="/" />
  <main id="content" class="about">
    <div class="about__text">
      {about.paragraphs.map((p) => <p>{p}</p>)}
    </div>
    <div class="about__grid">
      {about.images.map((i) => <img src={i.img} alt={i.alt} loading="lazy" decoding="async" />)}
    </div>
  </main>
</Base>
