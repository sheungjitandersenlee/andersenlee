---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import site from '../data/site.json';

const { portfolio } = site;
---
<Base theme="black" title="Portfolio">
  <PageHeader title={portfolio.title} back="/" />
  <main id="content" class="portfolio">
    {portfolio.items.map((p) => (
      <a class="portfolio__card" href={p.href}>
        <img src={p.img} alt="" loading="lazy" decoding="async" />
        <span class="portfolio__label">{p.label}</span>
      </a>
    ))}
  </main>
</Base>
